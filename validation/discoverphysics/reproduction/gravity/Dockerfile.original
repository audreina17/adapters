FROM python:3.12-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN pip install numpy==2.3.2 scipy==1.16.1 jax==0.7.1 pyyaml==6.0.2 anthropic==0.64.0 openai==1.102.0 requests==2.32.5
RUN git clone https://github.com/SampsonML/DiscoverPhysics.git /opt/discoverphysics && cd /opt/discoverphysics && git checkout 33b7fa9df96de9c35744efd181ca7e5a8dd60ad5 && pip install --no-deps -e PhysicsSchool -e ScienceAgent
COPY original/ /app/
WORKDIR /app
ENTRYPOINT ["python", "/app/upstream_entry.py"]
